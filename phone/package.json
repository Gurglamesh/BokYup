{
  "name": "bokyup-phone",
  "version": "0.1.0",
  "private": true,
  "description": "BokYup phone app — the web frontend + the Python backend as WebAssembly (Pyodide), wrapped with Capacitor. Fully local; no server.",
  "scripts": {
    "build:www": "python ../tools/../phone/build_www.py",
    "sync": "cap sync",
    "open:android": "cap open android",
    "open:ios": "cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/camera": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "@capacitor/filesystem": "^6.0.0",
    "@capacitor/ios": "^6.0.0",
    "@capacitor/share": "^6.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.0.0"
  }
}

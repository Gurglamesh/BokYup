# Copy to `.env` and set a strong token (this gates every client).
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(32))"
BOKYUP_API_TOKEN=change-me-to-a-long-random-secret

# Per-book auto-lock, seconds (the DEK is wiped from server RAM after this idle time).
BOKYUP_AUTOLOCK=900
